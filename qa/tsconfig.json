{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "types": ["node"],
        "lib": ["ES2020", "DOM"],
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["."]
}
