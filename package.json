{
  "name": "arithmon",
  "description": "A monster-collecting math RPG built with Phaser",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/pathfinding": "^0.1.0",
    "pathfinding": "^0.4.18",
    "phaser": "4.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.3.1",
    "vitest": "^4.1.4"
  }
}
